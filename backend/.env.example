# =====================================================
# EMI CONNECT - Variables de entorno del backend
# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el archivo .env al repositorio.
# =====================================================

# Puerto del servidor
PUERTO=4000
ENTORNO=desarrollo

# Base de datos
MONGODB_URI=mongodb://127.0.0.1:27017/emi_connect

# Seguridad
JWT_SECRETO=cambiar_por_un_secreto_largo_y_seguro
JWT_EXPIRACION=7d

# Dominio institucional permitido (unico dominio valido para registro)
DOMINIO_INSTITUCIONAL=@est.emi.edu.bo

# -----------------------------------------------------
# CORREO EMISOR (configuracion UNICA y CENTRALIZADA)
# Para cambiar la cuenta emisora solo se modifica este archivo.
# -----------------------------------------------------
CORREO_EMISOR=dtorricof@est.emi.edu.bo
CORREO_CONTRASENA=colocar_aqui_la_contrasena_o_token_de_aplicacion
CORREO_HOST=smtp.gmail.com
CORREO_PUERTO=587
CORREO_SEGURIDAD=true
CORREO_NOMBRE=EMI Connect
# Si el servidor SMTP no esta disponible, los correos se registran en consola (modo desarrollo)
CORREO_MODO_DESARROLLO=true

# -----------------------------------------------------
# FRONTEND
# -----------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------
# SUBIDA DE ARCHIVOS
# -----------------------------------------------------
ARCHIVO_TAMANO_MAXIMO_MB=8

# -----------------------------------------------------
# ADMINISTRADOR INICIAL (usado por npm run crear-admin)
# Si estos valores existen, el script puede ejecutarse sin preguntas.
# -----------------------------------------------------
ADMIN_NOMBRES=
ADMIN_APELLIDOS=
ADMIN_CORREO=
ADMIN_CONTRASENA=
